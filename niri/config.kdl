// Check the wiki for a full description of the configuration:
// https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction

include "input.kdl"
include "layout.kdl"
include "outputs.kdl"
layout{border{};} // For *some* reason fixes lack of border configuration
include "rules.kdl"
include "niri-binds.kdl"
include "custom-binds.kdl"

gestures { hot-corners { off; }; };
hotkey-overlay { skip-at-startup; }
clipboard { disable-primary; }
xwayland-satellite { path "xwayland-satellite"; }

prefer-no-csd
screenshot-path "~/imgs/screens/niri/screen-%Y.%m.%d-%H-%M-%S.png"

spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 16
}
