input {
    keyboard {
        xkb { layout "pl"; };
        repeat-delay 250
        repeat-rate 40
    }
    focus-follows-mouse max-scroll-amount="95%"

    trackpoint {
        accel-speed 0.5
        accel-profile "flat"
        scroll-method "on-button-down"
        scroll-button 274
    }

    mouse {
        accel-speed -0.3
        accel-profile "flat"
    }

    touchpad {
        off
        tap
        dwt
        dwtp
        drag true
        natural-scroll
        accel-speed 0.4
        accel-profile "adaptive"
        scroll-method "two-finger"
        scroll-factor 0.9
    }
}
